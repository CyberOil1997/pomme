{
  "name": "pomme",
  "productName": "Pomme",
  "version": "1.0.0",
  "description": "A pomodoro timer. An apple gets eaten while you focus.",
  "main": "main.js",
  "author": "CyberOil1997",
  "license": "MIT",
  "scripts": {
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --mac --universal",
    "build": "esbuild renderer/src/main.js --bundle --format=iife --minify --outfile=renderer/app.bundle.js",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "build": {
    "appId": "net.cyberoil.pomme",
    "productName": "Pomme",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "!renderer/src/**",
      "assets/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg"
        }
      ],
      "identity": null
    },
    "dmg": {
      "title": "Pomme",
      "iconSize": 112,
      "window": {
        "width": 600,
        "height": 400
      },
      "contents": [
        {
          "x": 170,
          "y": 200
        },
        {
          "x": 430,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Pomme",
      "artifactName": "Pomme-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.10",
    "three": "^0.181.0"
  }
}